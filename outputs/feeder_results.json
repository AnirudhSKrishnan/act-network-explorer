  "assumptions": [
    {
      "item": "Model status",
      "value": "Toy model",
      "basis": "Assumed loads and cable type; not an Evoenergy feeder study and not Evoenergy data."
    },
    {
      "item": "Route and section lengths",
      "value": "OpenStreetMap 11 kV ways",
      "basis": "Lengths measured on the OSM geometry in GDA2020 / MGA zone 55 (EPSG:7855). OSM is incomplete and may not match the real feeder route or switching."
    },
    {
      "item": "Path selection rule",
      "value": "Longest shortest 11 kV path from a zone substation",
      "basis": "From each zone substation, follow only line edges whose voltage tag includes 11000 V (other substations are barriers); take the node with the longest shortest-path distance (by GIS length) from the substation; across substations keep the longest (ties: smaller node id / substation OSM id)."
    },
    {
      "item": "Section merging",
      "value": "sections < 200 m merged",
      "basis": "Very short OSM sections joined to the previous one (first one to the next) so the model has a readable number of buses. Total length unchanged."
    },
    {
      "item": "Trunk only",
      "value": "branches ignored",
      "basis": "Branches leaving the path and their load are not modelled, so real trunk current would be higher than shown."
    },
    {
      "item": "Source",
      "value": "ext_grid, 1.00 pu at the zone substation 11 kV bus",
      "basis": "Assumed stiff source at nominal voltage. Real zone substations regulate the 11 kV bus with tap changers, often above 1.00 pu."
    },
    {
      "item": "Transformer",
      "value": "not modelled",
      "basis": "No 132(66)/11 kV zone transformer and no 11 kV/415 V distribution transformers; loads sit directly on 11 kV buses."
    },
    {
      "item": "Nominal voltage",
      "value": "11 kV",
      "basis": "From the OSM voltage tag."
    },
    {
      "item": "Conductor",
      "value": "NA2XS2Y 1x185 RM/25 12/20 kV (all sections)",
      "basis": "pandapower standard type (r = 0.161 Ω/km, x = 0.117 Ω/km, c = 273 nF/km, rating 362 A). Chosen because the project brief suggests it and it ships with pandapower: a common European 185 mm² Al XLPE 12/20 kV cable. Most of this OSM path is overhead (power=line/minor_line, one short power=cable section) and real ACT 11 kV conductors differ; overhead lines have higher reactance, lower capacitance and different ratings."
    },
    {
      "item": "Load size",
      "value": "200 kW per load",
      "basis": "Assumed round number, not measured demand."
    },
    {
      "item": "Power factor",
      "value": "0.95 lagging (65.7 kvar per load)",
      "basis": "Assumed."
    },
    {
      "item": "Load placement",
      "value": "one load at every bus except the source (9 loads)",
      "basis": "Assumed: one load at the far end of each (merged) section."
    },
    {
      "item": "Load model",
      "value": "constant power (PQ), balanced 3-phase",
      "basis": "Positive-sequence load flow (pp.runpp, Newton-Raphson); no unbalance, no voltage dependence."
    },
    {
      "item": "Doubled-load case",
      "value": "all loads x2",
      "basis": "Uniform scaling of every load."
    },
    {
      "item": "Voltage planning reference",
      "value": "±6 % (0.94–1.06 pu)",
      "basis": "Typical-practice reference only, not Evoenergy's standard. In practice the 11 kV network gets only part of the end-to-end voltage budget (the LV network and distribution transformer also drop voltage)."
    },
    {
      "item": "Thermal reference",
      "value": "100 % of the std-type max_i_ka",
      "basis": "pandapower's rating for that cable under its reference installation conditions; no derating."
    }
  ],
